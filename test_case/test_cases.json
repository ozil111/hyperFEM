{
  "test_cases": [
    {
      "name": "tet4_mat1_im",
      "steps":[
        {
          "command": "../bin/Debug/NovaFEA_app.exe",
          "args":["-i","tet4_mat1_im/tet4_mat1_im.jsonc","--output","tet4_mat1_im/tet4_mat1_im.vtu"],
          "expected": {
            "output_contains": ["Application finished successfully"]
          }
        },
        {
          "command": "compare-files",
          "args": [
            "tet4_mat1_im/tet4_mat1_im.vtu",
            "tet4_mat1_im/benchmark/tet4_mat1_im.vtu",
            "--file-type=text"
          ],
          "expected": {
            "output_contains": [
              "Files are identical"
            ]
          }
        }
      ]
    },
    {
      "name": "abaqus_parser_t01_explicit",
