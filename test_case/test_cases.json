          "expected": {
            "output_contains": ["Application finished successfully"]
          }
        },
        {
          "command": "python",
          "args":["-s","abaqus_T01_explicit/run_abaqus.py","abaqus_T01_explicit/abaqus_T01_export.inp"],
          "expected": {
            "output_contains": ["运行完成"]
          }
        }
      ]
    },
    {
