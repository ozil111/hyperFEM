{
  "test_cases": [
    {
      "name": "c3d8r_im_t01",
      "tags": ["c3d8r", "linear-static", "small-strain", "single-element", "pipeline"],
      "steps": [
        {
          "command": "python",
          "args": ["implicit_c3d8r/tools/run_abaqus_benchmark.py", "implicit_c3d8r/T01/T01_im.inp"],
          "expected": {
            "return_code": 0,
            "output_contains": ["运行完成"]
          }
        },
        {
          "command": "../bin/Debug/NovaFEA_app.exe",
          "args": ["-s", "implicit_c3d8r/T01/import_export.nova"],
          "expected": {
            "output_contains": ["Application finished successfully"]
          }
        },
        {
          "command": "../bin/Debug/NovaFEA_app.exe",
          "args": ["-i", "implicit_c3d8r/T01/T01_im.jsonc", "--output", "implicit_c3d8r/T01/T01_im.vtk", "--output-csv", "implicit_c3d8r/T01/T01_im"],
          "expected": {
            "output_contains": ["Linear static solver completed.", "Application finished successfully"]
          }
        }
      ],
      "expected": {
        "compare_files": [
          {
            "baseline": "./implicit_c3d8r/T01/T01_im_abaqus_disp.csv",
            "actual": "./implicit_c3d8r/T01/T01_im_disp.csv",
            "type": "csv", "rtol": 0.02
          },
          {
            "baseline": "./implicit_c3d8r/T01/T01_im_abaqus_elements.csv",
            "actual": "./implicit_c3d8r/T01/T01_im_elements.csv",
            "type": "csv", "rtol": 0.02, "atol": 0.01
          }
        ]
      }
    },
